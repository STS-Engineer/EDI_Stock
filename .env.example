# Set through the hosting platform's secret settings. Never commit real values.
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
SECRET_KEY=REPLACE_WITH_A_STRONG_SERVER_SECRET
IMPORT_API_TOKEN=REPLACE_WITH_AN_APPROVED_API_TOKEN
PREVIEW_DIR=/var/lib/edi-stock/previews
# false only for a local HTTP test; true for every HTTPS deployment.
COOKIE_SECURE=true

# Enable only after platform authentication/access restrictions are verified.
UI_IMPORTS_ENABLED=false
